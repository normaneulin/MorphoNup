# MorphoNup repository. Published: the package (morphonup/), the notebooks, the run scripts, the documentation
# (README.md, docs/), requirements.txt and the dataset archive (dataset/MorphoNup_data.z*). Everything below stays local.

# Datasets unzipped from dataset/MorphoNup_data.zip (README section 3); only the archive is versioned
/data/
/MorphoNup_data_joined.zip

# Outputs of training and analysis runs: models, predictions, figures, logs (regenerated by the package)
/results/

/paper/

/website/

/ROADMAP.md
/reports/
/tests/

# Development scripts: regenerate the notebooks and the static diagrams in docs/figures/
/scripts/build_notebooks.py
/scripts/draw_diagrams.py

# Python, Jupyter, editors, operating system
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.virtual_documents/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.env
